{
  "$schema": "https://opencode.ai/config.json",
  "worktree": {
    "directory": "~/linux-desktop-guide-worktrees"
  },
  "mcp": {
    "servers": {
      // Local, read-only docs MCP; see README and AGENTS.
      "docs": {
        "type": "local",
        "command": ["node", "tools/docs-mcp/server.mjs"],
        "cwd": ".",
        "codemode": true,
        "timeout": {
          "startup": 30000
        }
      }
    }
  }
}
