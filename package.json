{
	"name": "linux-desktop-guide",
	"type": "module",
	"version": "1.0.0",
	"private": true,
	"license": "MIT",
	"description": "A field guide to building native, high-quality Linux desktop apps.",
	"scripts": {
		"dev": "astro dev",
		"start": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"astro": "astro",
		"check:baseline": "node scripts/check-baseline.mjs",
		"postbuild": "node scripts/rewrite-base.mjs && node scripts/generate-agent-docs.mjs",
		"check:agent-docs": "node scripts/check-agent-docs.mjs",
		"mcp:docs": "node tools/docs-mcp/server.mjs",
		"test:docs-mcp": "node --test tools/docs-mcp/test/pages.test.mjs tools/docs-mcp/test/search.test.mjs tools/docs-mcp/test/related.test.mjs tools/docs-mcp/test/baseline.test.mjs tools/docs-mcp/test/text.test.mjs tools/docs-mcp/test/server.test.mjs",
		"build:guide-mcp": "node tools/guide-mcp/build.mjs",
		"test:guide-mcp": "npm run build:guide-mcp && node --test tools/guide-mcp/test/*.test.mjs",
		"check:guide-package": "node scripts/check-guide-package.mjs",
		"check:mcp": "node scripts/check-mcp-deployed.mjs",
		"check:links": "node scripts/check-links.mjs",
		"check:links:external": "node scripts/check-links.mjs --external",
		"check:docs": "node scripts/check-docs.mjs",
		"check:links:external:strict": "node scripts/check-links.mjs --external --strict",
		"check:quality": "node scripts/check-quality.mjs",
		"check:examples": "node scripts/check-examples.mjs",
		"check:targets": "node scripts/check-targets.mjs",
		"check:pwa": "node scripts/check-pwa.mjs",
		"generate:pwa-icons": "node scripts/generate-pwa-icons.mjs",
		"check:deployed": "node scripts/check-deployed.mjs",
		"check:root-build": "BASE_PATH=/ SITE_URL=https://example.com npm run build && node scripts/check-root-build.mjs",
		"check:freshness": "node scripts/check-freshness.mjs",
		"test:freshness": "node --test scripts/freshness.test.mjs"
	},
	"dependencies": {
		"@astrojs/markdown-remark": "^7.3.7",
		"@astrojs/starlight": "^0.42.10",
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@fontsource-variable/space-grotesk": "^5.3.0",
		"@modelcontextprotocol/sdk": "^1.32.2",
		"astro": "^7.3.6",
		"minisearch": "^7.2.0",
		"sharp": "^0.35.3",
		"yaml": "^2.9.1",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"chrome-launcher": "^1.2.3",
		"esbuild": "^0.28.2",
		"lighthouse": "^13.6.0",
		"linkedom": "^0.18.15",
		"turndown": "^7.2.5",
		"turndown-plugin-gfm": "^1.0.2"
	},
	"engines": {
		"node": ">=24"
	}
}
