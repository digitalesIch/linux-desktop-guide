---
---

<div class="ldg-cursor-glow" aria-hidden="true"></div>

<script>
	(() => {
		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		const finePointer = window.matchMedia('(pointer: fine)').matches;
		const hero = document.querySelector('.hero');
		const art = document.querySelector('.hero .hero-html');
		const glow = document.querySelector('.ldg-cursor-glow');
		const ticker = document.querySelector('.ldg-ticker-track');

		if (!hero) return;

		if (!reduceMotion) {
			for (const section of document.querySelectorAll('.ldg-section')) {
				section.classList.add('ldg-reveal');
			}

			if (!('IntersectionObserver' in window)) {
				for (const section of document.querySelectorAll('.ldg-reveal')) {
					section.classList.add('is-visible');
				}
			} else {
				const observer = new IntersectionObserver(
					(entries) => {
						for (const entry of entries) {
							if (!entry.isIntersecting) continue;
							entry.target.classList.add('is-visible');
							observer.unobserve(entry.target);
						}
					},
					{ threshold: 0.12, rootMargin: '0px 0px -8% 0px' }
				);

				for (const section of document.querySelectorAll('.ldg-reveal')) {
					observer.observe(section);
				}
			}
		}

		if (!finePointer || reduceMotion) return;

		let frame = 0;
		let targetX = 0;
		let targetY = 0;
		const paint = () => {
			frame = 0;
			hero.style.setProperty('--mx', `${targetX * 100}%`);
			hero.style.setProperty('--my', `${targetY * 100}%`);

			if (art) {
				const rotateY = (targetX - 0.5) * 4.5;
				const rotateX = (0.5 - targetY) * 3.5;
				art.style.transform = `perspective(900px) rotateX(${rotateX.toFixed(2)}deg) rotateY(${rotateY.toFixed(2)}deg) translateY(-3px)`;
			}
		};

		hero.addEventListener('pointermove', (event) => {
			const rect = hero.getBoundingClientRect();
			targetX = Math.min(1, Math.max(0, (event.clientX - rect.left) / rect.width));
			targetY = Math.min(1, Math.max(0, (event.clientY - rect.top) / rect.height));
			if (!frame) frame = requestAnimationFrame(paint);
		});

		hero.addEventListener('pointerleave', () => {
			targetX = 0.5;
			targetY = 0.5;
			if (!frame) frame = requestAnimationFrame(paint);
		});

		for (const card of document.querySelectorAll('.ldg-card, .ldg-contract, .ldg-linkcard')) {
			card.addEventListener('pointermove', (event) => {
				const rect = card.getBoundingClientRect();
				card.style.setProperty('--card-x', `${((event.clientX - rect.left) / rect.width) * 100}%`);
				card.style.setProperty('--card-y', `${((event.clientY - rect.top) / rect.height) * 100}%`);
			});
		}

		if (glow) {
			window.addEventListener(
				'pointermove',
				(event) => {
					glow.classList.add('is-active');
					glow.style.transform = `translate3d(${event.clientX}px, ${event.clientY}px, 0) translate(-50%, -50%)`;
				},
				{ passive: true }
			);
		}

		if (ticker) {
			ticker.addEventListener('pointerenter', () => {
				ticker.style.animationPlayState = 'paused';
			});
			ticker.addEventListener('pointerleave', () => {
				ticker.style.animationPlayState = 'running';
			});
		}
	})();
</script>
