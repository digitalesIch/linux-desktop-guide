---
import { BASE_URL } from '../../site.config.mjs';

const { head, id } = Astro.locals.starlightRoute;
const base = BASE_URL;
const markdownHref = id === '404' || id === 'index' || !id ? undefined : `${base}${id}.md`;
---

<script is:inline>document.documentElement.classList.add('js');</script>

{head.map(({ tag: Tag, attrs, content }) => (
	<Tag {...attrs} set:html={content} />
))}

{markdownHref && (
	<link rel="alternate" type="text/markdown" href={markdownHref} title="Markdown version" />
)}
{id !== '404' && <link rel="describedby" href={`${base}llms.txt`} />}

<link rel="manifest" href={`${base}manifest.webmanifest`} />
<meta name="theme-color" content="#faf9f6" />
<meta name="application-name" content="Linux Desktop Guide" />
<meta name="mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="black" />
<meta name="apple-mobile-web-app-title" content="Linux Desktop Guide" />
<link rel="apple-touch-icon" sizes="180x180" href={`${base}icons/apple-touch-icon.png`} />
<link rel="icon" type="image/png" sizes="192x192" href={`${base}icons/icon-192.png`} />
<link rel="icon" type="image/png" sizes="512x512" href={`${base}icons/icon-512.png`} />

{import.meta.env.PROD && (
	<script is:inline define:vars={{ swPath: `${base}sw.js`, swScope: base }}>
		if ('serviceWorker' in navigator) {
			window.addEventListener('load', () => {
				navigator.serviceWorker.register(swPath, { scope: swScope }).catch(() => {});
			});
		}
	</script>
)}
