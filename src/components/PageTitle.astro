---
import { BASE_URL } from '../../site.config.mjs';

const { entry, id } = Astro.locals.starlightRoute;
const base = BASE_URL;
const description = entry.data.description;
const section = id.split('/')[0];

const sections: Record<string, string> = {
	start: 'Start Here',
	platform: 'Platform',
	design: 'Design',
	engineering: 'Engineering',
	ship: 'Ship',
	reference: 'Reference',
};

const sectionLabel = sections[section];
const markdownHref = id === '404' || id === 'index' || !id ? undefined : `${base}${id}.md`;
---

<div class="page-header">
	<div class="page-meta">
		{sectionLabel && (
			<p class="page-eyebrow">
				<span>{sectionLabel}</span>
			</p>
		)}
		<div class="page-links">
			{id !== 'reference/feedback' && (
				<a class="page-markdown" href={`${base}reference/feedback/`}>Feedback</a>
			)}
			{markdownHref && (
				<a class="page-markdown" href={markdownHref}>Markdown</a>
			)}
		</div>
	</div>
	<h1 id="_top">{entry.data.title}</h1>
	{description && <p class="page-lede">{description}</p>}
</div>

<style>
	.page-header {
		margin-block: 0.25rem 1.25rem;
	}

	.page-meta {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 0.95rem;
	}

	.page-links {
		display: flex;
		align-items: center;
		gap: 0.9rem;
		margin-left: auto;
	}

	.page-eyebrow {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		margin: 0;
		font-family: var(--sl-font-mono);
		font-size: 0.68rem;
		font-weight: 600;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--sl-color-accent);
	}

	.page-eyebrow::before {
		content: '';
		width: 1.4rem;
		height: 1px;
		background: currentColor;
		opacity: 0.75;
	}

	h1 {
		margin: 0;
		font-family: var(--ldg-font-display);
		font-size: clamp(2.15rem, 4.4vw, 3.35rem);
		font-weight: 600;
		line-height: 1.02;
		letter-spacing: -0.045em;
		color: var(--sl-color-white);
		text-wrap: balance;
	}

	.page-markdown {
		font-family: var(--sl-font-mono);
		font-size: 0.64rem;
		font-weight: 500;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--sl-color-gray-3);
		text-decoration: none;
		white-space: nowrap;
	}

	.page-markdown:hover {
		color: var(--sl-color-accent);
	}

	.page-lede {
		max-width: 66ch;
		margin: 1.05rem 0 0;
		font-size: 1.03rem;
		line-height: 1.65;
		color: var(--sl-color-gray-2);
		text-wrap: pretty;
	}

	@media (max-width: 40rem) {
		.page-header {
			margin-bottom: 0.75rem;
		}

		.page-markdown {
		font-family: var(--sl-font-mono);
		font-size: 0.64rem;
		font-weight: 500;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--sl-color-gray-3);
		text-decoration: none;
		white-space: nowrap;
	}

	.page-markdown:hover {
		color: var(--sl-color-accent);
	}

	.page-lede {
			font-size: 0.97rem;
		}
	}
</style>
